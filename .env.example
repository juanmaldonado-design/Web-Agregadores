# Copiar a .env.local y completar con las credenciales del proyecto en supabase.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts server-side (importación de Excel). Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Clave que se pide en /importar antes de aceptar un Excel. Genera una propia con:
# node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
IMPORT_UPLOAD_SECRET=
